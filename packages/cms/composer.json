{
  "name": "shopper/cms",
  "description": "WordPress-style posts, pages and taxonomies for Shopper",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ezyang/htmlpurifier": "^4.19",
    "jfcherng/php-diff": "^7.0",
    "shopper/core": "*",
    "shopper/framework": "*",
    "shopper/seo": "*"
  },
  "autoload": {
    "psr-4": {
      "Shopper\\Cms\\": "src/",
      "Shopper\\Cms\\Database\\Factories\\": "database/factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shopper\\Cms\\CmsServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
