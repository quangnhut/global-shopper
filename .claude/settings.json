{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": ".claude/plans",
  "permissions": {
    "allow": [
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec app vendor/bin/pest:*)",
      "Bash(docker compose exec -T app vendor/bin/pest:*)",
      "Bash(docker compose exec app vendor/bin/phpstan:*)",
      "Bash(docker compose exec -T app vendor/bin/phpstan:*)",
      "Bash(docker compose exec app vendor/bin/pint:*)",
      "Bash(docker compose exec -T app vendor/bin/pint:*)",
      "Bash(docker compose exec app vendor/bin/testbench route:list:*)",
      "Bash(docker compose exec -T app vendor/bin/testbench route:list:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(npm run build:*)",
      "Bash(npm run prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(docker compose exec app vendor/bin/testbench migrate:fresh:*)",
      "Bash(docker compose exec -T app vendor/bin/testbench migrate:fresh:*)",
      "Bash(docker compose down:*)",
      "Bash(composer require:*)",
      "Bash(composer update:*)",
      "Bash(npm install:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(rm -rf uploads:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/php-quality.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
