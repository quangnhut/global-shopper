# Copy to .env.production on the server, fill in the empty values, then:
#   docker compose --env-file .env.production up -d --build
# Read by Docker Compose and mounted into the containers as the app's environment.
APP_NAME=Shopper
APP_ENV=production
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com
APP_PORT=8000

AUTH_MODEL=Workbench\App\Models\User

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shopper
DB_USERNAME=shopper
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=public

VIEW_COMPILED_PATH=/tmp/shopper-views

SHOPPER_CMS_ROUTES=true
# Blade storefront (home page, search, customer sign-in) at /. Off by default in the package.
SHOPPER_STOREFRONT_ROUTES=true
# Header language picker (Google Translate in the browser). Admins can also hide it under Storefront → Header & footer.
SHOPPER_STOREFRONT_TRANSLATE=true
# Telegram order alerts: ./telegram.json next to docker-compose.yml (gitignored), mounted read-only here.
SHOPPER_TELEGRAM_CONFIG=/var/www/html/workbench/telegram.json
# OnePay domestic cards (from the merchant contract). Give OnePay the IPN URL {APP_URL}/api/onepay/ipn.
ONEPAY_SANDBOX=false
ONEPAY_MERCHANT_ID=
ONEPAY_ACCESS_CODE=
ONEPAY_HASH_SECRET=
ONEPAY_QUERY_USER=
ONEPAY_QUERY_PASSWORD=

# Do not use the default: this is the admin login's URL (https://shop.example.com/<prefix>/login).
SHOPPER_PREFIX=
