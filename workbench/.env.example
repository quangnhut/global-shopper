APP_NAME=Shopper
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_PORT=8088

AUTH_MODEL=Workbench\App\Models\User

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shopper
DB_USERNAME=shopper
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
FORWARD_DB_PORT=3307

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=public

# Keep the dev server's compiled views apart from the test suite's.
VIEW_COMPILED_PATH=/tmp/shopper-views

# Server-rendered CMS pages with the SEO head (dev demo; off by default in real apps)
SHOPPER_CMS_ROUTES=true

# Admin URL prefix (http://localhost:8088/<prefix>). Restart the app container after changing it.
SHOPPER_PREFIX=cpanel
